# setup:local preserves existing values and adds missing authentication/mail defaults.
# Process environment wins. Values are literal (no interpolation).
NODE_ENV=development
WEB_PORT=4200
API_PORT=3000
WEB_ORIGIN=http://localhost:4200
PUBLIC_API_BASE_URL=http://localhost:3000/api
SSR_API_BASE_URL=http://127.0.0.1:3000/api
MONGO_PORT=27017
# Bootstrap stays in infrastructure. App/test identities own only their DB.
MONGO_INITDB_ROOT_USERNAME=viedom_root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_USERNAME=viedom_app
MONGO_APP_PASSWORD=
MONGO_TEST_USERNAME=viedom_test
MONGO_TEST_PASSWORD=
MONGO_DB_NAME=viedom_local
MONGO_TEST_DB_NAME=viedom_test
# Encoded host URIs with authSource, rs0 and directConnection.
MONGO_URI=
MONGO_TEST_URI=
# Server-only authentication. setup:local generates ACCESS_TOKEN_SECRET.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=viedom_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave both blank to disable Google sign-in locally; email/password still works.
# Google Console: Web application, redirect URI PUBLIC_API_BASE_URL/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only SMTP. Local Mailpit; production requires an authenticated provider
# and TLS (SMTP_SECURE=true for implicit TLS, false for mandatory STARTTLS).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@viedom.test
SMTP_USER=
SMTP_PASSWORD=
MAIL_UI_PORT=8025
# Explicit browser allowlist.
PUBLIC_LOCALE=en-GB
PUBLIC_CURRENCY=EUR
PUBLIC_CITY=Thessaloniki
PUBLIC_MAP_LONGITUDE=22.9444
PUBLIC_MAP_LATITUDE=40.6401
PUBLIC_MAP_ZOOM=12
