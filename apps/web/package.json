{
  "name": "@viedom/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prepare:config": "node ../../scripts/generate-web.mjs",
    "dev": "node ../../scripts/web-dev.mjs",
    "build": "pnpm prepare:config && ng build",
    "start": "node dist/web/server/server.mjs",
    "typecheck": "pnpm prepare:config && ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "pnpm prepare:config && ng test --watch=false"
  },
  "dependencies": {
    "@viedom/contracts": "workspace:*",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/cdk": "22.2.6",
    "@angular/ssr": "22.2.5",
    "express": "5.3.0",
    "ng-zorro-antd": "22.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@tailwindcss/postcss": "4.3.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "sass": "1.107.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
