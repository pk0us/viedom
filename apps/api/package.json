{
  "name": "@viedom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node test/database-smoke.ts && vitest run --config vitest.database.config.ts",
    "db:indexes": "pnpm build && node dist/database/cli.js indexes",
    "db:seed": "pnpm build && node dist/database/cli.js seed",
    "db:admin": "pnpm build && node dist/database/admin-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@mikro-orm/core": "7.2.7",
    "@mikro-orm/mongodb": "7.2.7",
    "@mikro-orm/nestjs": "7.1.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.3",
    "@viedom/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "mongodb": "7.8.0",
    "nodemailer": "10.3.1",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
